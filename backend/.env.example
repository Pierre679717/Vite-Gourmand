# ================================================================
# .env.example — modèle des variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).
# ================================================================

# Serveur
PORT=3000
FRONTEND_URL=http://localhost:4200

# JWT (obligatoire : le serveur refuse de démarrer sans)
# Générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=24h

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vite_gourmand

# MongoDB (statistiques des commandes)
# En local : 127.0.0.1 et non localhost (Node peut résoudre localhost en IPv6 ::1)
MONGO_URI=mongodb://127.0.0.1:27017/vite_gourmand

# E-mails (Mailtrap en développement)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM=Vite & Gourmand <no-reply@vite-gourmand.fr>
