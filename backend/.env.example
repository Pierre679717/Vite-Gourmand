# ================================================================
# .env.example — modèle des variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).
# ================================================================

# Serveur
PORT=3000
# Mettre NODE_ENV=production chez l'hébergeur (Railway) : CORS limité à
# FRONTEND_URL, confiance au proxy pour l'IP du visiteur, HTTPS forcé (CSP).
# En local, laisser la ligne commentée.
# NODE_ENV=production
# Adresse du site : autorisée par CORS et utilisée dans les liens des e-mails
# (en production : l'adresse publique, ex. https://vite-gourmand.up.railway.app)
FRONTEND_URL=http://localhost:4200

# JWT (obligatoire : le serveur refuse de démarrer sans)
# Générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=24h

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vite_gourmand

# MongoDB (statistiques des commandes)
# En local : 127.0.0.1 et non localhost (Node peut résoudre localhost en IPv6 ::1)
MONGO_URI=mongodb://127.0.0.1:27017/vite_gourmand

# E-mails (Mailtrap en développement)
# En local : SMTP Mailtrap (EMAIL_*). Sur Railway (offre Hobby), les ports
# SMTP sortants sont bloqués : on passe par l'API HTTPS de Mailtrap en
# définissant MAILTRAP_API_TOKEN et MAILTRAP_INBOX_ID (EMAIL_* alors ignorées).
# MAILTRAP_API_TOKEN=
# MAILTRAP_INBOX_ID=
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
# Adresse de l'entreprise qui reçoit les messages du formulaire de contact
CONTACT_DESTINATAIRE=contact@vite-gourmand.fr
MAIL_FROM=Vite & Gourmand <no-reply@vite-gourmand.fr>
